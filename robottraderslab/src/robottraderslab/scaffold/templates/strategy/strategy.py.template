from dataclasses import dataclass
from datetime import datetime
from typing import ClassVar

from robottraderslab.exceptions import ProfileConfigError
from robottraderslab.indicators import crossover, crossunder, sma
from robottraderslab.strategies import (
    AccountSnapshots,
    BookKeeper,
    MarketType,
    OHLCVs,
    PositionSide,
    Profile,
    ProfileStrategy,
    StrategyRequirements,
)
from robottraderslab.strategies.futures import FuturesAccount, SizingRule


@dataclass(frozen=True, kw_only=True)
class $profile_class(Profile):
    fast_ma_length: int
    slow_ma_length: int
    sizing: SizingRule

    def __post_init__(self) -> None:
        # Refuse a profile the strategy cannot trade: a fast average that is not
        # shorter than the slow one cannot cross it as intended. Raising
        # ProfileConfigError from __post_init__ refuses this profile. Live, every
        # profile on its symbol sits out the run, with one ERROR line naming the
        # refused profile and the reason, and the profiles of the other symbols
        # trade, unless the bot keeps a copy of its last working configuration
        # file and the section came with an edit, which runs the symbol from the
        # copy in exit-only mode; in a backtest the run stops naming the profile. A
        # BotCriticalError raised here would stop the whole bot, or, on a bot
        # with a working copy and after an edit, make it run the copy, so keep
        # it for a problem no profile can trade through.
        if self.fast_ma_length >= self.slow_ma_length:
            raise ProfileConfigError(
                f"fast_ma_length ({self.fast_ma_length}) must be below "
                f"slow_ma_length ({self.slow_ma_length})"
            )


# All the best with building and implementing your strategy. I wish you every
# success with it, and thank you for using the Lab.
# Happy trading, and take care.
# Louis
#
# This is a profile strategy: a strategy where you configure the markets it
# trades, the timeframes and the parameters of each. Each [[strategy.profiles]]
# section of the bot's bot.toml becomes one profile, and the engine runs the
# methods below for each of them. How to write one:
# https://robottraders.io/lab/docs/implement-a-strategy.html#the-shape-of-a-strategy
class $class_name(ProfileStrategy[$profile_class]):
    """Holds one profile per market.

    The position it reads from the account is the whole position of that
    market, so profiles sharing a market need a position tracker.
    """

    market_type: ClassVar[MarketType] = "futures"

    account: FuturesAccount

    async def setup(self, requirements: StrategyRequirements) -> None:
        """Declare the candles and account state the profiles read.

        A profile's lookback is its slow average's length, the warm-up that
        fills the average before the first candle traded.
        """
        for profile in self.profiles:
            # Declare the candles this profile reads. The lookback is the
            # warm-up: candles loaded before the trading window for the slow
            # average to be full on the first candle traded.
            requirements.ohlcv.add(
                profile.symbol, profile.timeframe, lookback=profile.slow_ma_length
            )

        # Declare the account state the strategy reads for its symbols: the
        # positions, to know what is held, and the balances, to size an entry.
        requirements.account.add(
            self.account,
            symbols=[profile.symbol for profile in self.profiles],
            positions=True,
            balances=True,
            sizing=[profile.sizing for profile in self.profiles],
        )

    def generate_profile_signals(
        self, profile: $profile_class, ohlcvs: OHLCVs
    ) -> None:
        """Store the buy and sell flags of the profile as one column per flag.

        book_profile_actions reads them for each candle.
        """
        # An indicator the library does not have is computed on the array of
        # closes with numpy, over the whole array at once: a Python loop over
        # the candles gives the same values, only slower. A simple moving
        # average of length ma_length, for one:
        #
        #   import numpy as np
        #
        #   windows = np.lib.stride_tricks.sliding_window_view(close, ma_length)
        #   average = np.full(close.shape, np.nan)
        #   average[ma_length - 1 :] = windows.mean(axis=1)
        #
        # Each row of windows is the last ma_length closes up to one candle;
        # the first ma_length - 1 candles have no full window and stay NaN.

        # Read the closes of the whole window as one numpy array: signals are
        # computed once for all candles, and only the booking runs per candle.
        close = ohlcvs.column(profile.symbol, profile.timeframe, "close")

        # The library has sma, which also skips the stamps a market left empty
        # where the sketch above assumes there are none, so the two averages
        # use it:
        fast = sma(close, profile.fast_ma_length)
        slow = sma(close, profile.slow_ma_length)

        # Store a True or False per candle as the column "buy", which
        # book_profile_actions reads. crossover is True on the candle where the
        # fast average moves above the slow one: above it now, at or below it
        # on the candle before. A comparison of your own with an earlier candle
        # reads it with value_periods_ago(series, periods).
        ohlcvs.add_column(
            profile.symbol, profile.timeframe, "buy", crossover(fast, slow)
        )

        # Sell: the mirror image, crossunder is True on the candle where the
        # fast average moves below the slow one.
        ohlcvs.add_column(
            profile.symbol, profile.timeframe, "sell", crossunder(fast, slow)
        )

    # This strategy reads the position of a market from the account, so it
    # holds one profile per market. Trading the same market on
    # several timeframes or parameter sets needs position tracking: the venue
    # nets their orders into one position, so each profile tags its orders and
    # tracks its own position. Impulse, a strategy in a public repository,
    # does it: https://github.com/RobotTraders/RobotTradersLab/tree/main/plugins/robottraderslab-impulse
    def book_profile_actions(
        self,
        profile: $profile_class,
        ohlcvs: OHLCVs,
        account_snapshots: AccountSnapshots,
        timestamp: datetime,
        bookkeeper: BookKeeper,
    ) -> None:
        """Read the market's whole position from the account.

        Profiles sharing a market need a position tracker to book their own
        orders.
        """
        # Read the signals of the candle being traded; most candles have
        # neither, and then there is nothing to book.
        buy = ohlcvs.signal(profile.symbol, profile.timeframe, "buy")
        sell = ohlcvs.signal(profile.symbol, profile.timeframe, "sell")
        if not (buy or sell):
            return

        # The snapshot holds the account state declared in setup; the
        # position is the one held on this market, or None when flat.
        account_snapshot = account_snapshots.of(self.account)
        position = account_snapshot.position(profile.symbol)

        # The close of the candle being traded prices the entry's size.
        close = ohlcvs.current(profile.symbol, profile.timeframe, "close")

        # A buy closes a short if one is held, then opens a long sized by the
        # profile's sizing rule. Already long, it books nothing.
        if buy and (position is None or position.side == PositionSide.SHORT):
            if position is not None:
                bookkeeper.add(
                    self.account.short_exit(profile.symbol, position.quantity).reason(
                        "ma crossover buy"
                    )
                )

            entry = self.account.long_entry(profile.symbol)
            bookkeeper.add(
                entry.size(profile.sizing, close, account_snapshot).reason(
                    "ma crossover buy"
                )
            )

        # A sell is the mirror image: it closes a long if one is held, then
        # opens a short.
        elif sell and (position is None or position.side == PositionSide.LONG):
            if position is not None:
                bookkeeper.add(
                    self.account.long_exit(profile.symbol, position.quantity).reason(
                        "ma crossover sell"
                    )
                )

            entry = self.account.short_entry(profile.symbol)
            bookkeeper.add(
                entry.size(profile.sizing, close, account_snapshot).reason(
                    "ma crossover sell"
                )
            )
